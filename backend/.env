# Copy this file to .env and fill in your values before running the backend.

# A long random string. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Set to False in production (Render).
DEBUG=True

# Your Neon Postgres connection string, for example:
# postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/carelink?sslmode=require
# Leave empty to fall back to a local SQLite file for quick testing.
DATABASE_URL=

# Comma separated list of hosts allowed to serve this backend.
# On Render this is your service hostname, for example carelink-api.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma separated list of frontend origins allowed to call this API.
# On Vercel this is your deployed frontend URL.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# The public URL of the frontend, used to build invite links in emails.
FRONTEND_URL=http://localhost:5173

# Google Gemini API key for the AI assistant and AI search. Optional.
# Without it, the AI endpoints return a helpful offline message.
GEMINI_API_KEY=

# Microsoft Graph credentials for the Outlook referral intake. Optional placeholder.
# These stay empty until your Microsoft 365 admin grants an app registration.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
OUTLOOK_INTAKE_MAILBOX=
